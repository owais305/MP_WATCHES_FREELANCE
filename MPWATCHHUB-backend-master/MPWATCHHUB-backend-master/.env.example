# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mpwatchhub?retryWrites=true&w=majority

# Private Admin Dashboard passcode (Required for admin dashboard access)
ADMIN_PASSCODE=admin123

# Razorpay API Credentials (Leave empty to trigger Simulated UPI Mode automatically!)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
